clear; close all;

% Kinetic parameters.
a = 0.026;
b = 0.053;

% Ratio of diffusion parameters.
d = 2;

% Domain length.
L = 500;

% Number of grid points.
N = 1000;
dx = L/(N-1);

% Spatial grid.
x = linspace(0,L,N)';

% Kinetic functions.
f = @(u,v) u.^2.*v - (a+b)*u;
g = @(u,v) -u.^2.*v + a*(1-v);

% Initial conditions.
uinit = [exp(-x.^2); ones(N,1)];

% Create the Laplacian matrix.
one_vec = ones(N,1);
lap = spdiags([one_vec, -2*one_vec, one_vec],[1,0,-1],N,N);

% Set the boundary conditions.
lap(1,1) = -1;
lap(N,N) = -1;

lap = (1/dx^2)*lap;

% MATLAB ODE solvers need functions of the form F(t,U).
F = @(t,U) [f(U(1:N),U(N+1:2*N)) + lap*U(1:N); ...
    g(U(1:N),U(N+1:2*N)) + d*lap*U(N+1:2*N)];

% Get solution at times between 0 and 10^4.
T = linspace(0,1e4,200);

% Solve the system using a stiff solver and low tolerances.
odeparams = odeset('RelTol',1e-10,'AbsTol',1e-10, 'Stats','on');
[T,U] = ode15s(F,T,uinit,odeparams);

% Extract solutions.
u = U(:,1:N);
v = U(:,N+1:2*N);

% Plot u(t,x).
figure;
surf(x,T,u,'EdgeColor','none');
xlabel('x');
ylabel('t');
title('Gray-Scott Model: a = 0.026, b = 0.052');
colorbar;
view(2);
